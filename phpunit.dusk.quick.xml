<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <!-- Browser suite only. The default phpunit.xml.dist deliberately does not
         list tests/Browser, so `./vendor/bin/pest` stays fast and Chrome-free;
         run this one via `composer test:browser`.

         tests/Browser/Matrix holds the exhaustive, data-driven scenarios — every option
         of the package shown working in Chrome (see tests/Support/OptionUniverse.php).
         They are part of this suite; THIS file is the quick variant and leaves them out. -->
    <testsuites>
        <testsuite name="Browser">
            <directory>tests/Browser</directory>
            <exclude>tests/Browser/Matrix</exclude>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing"/>
    </php>
</phpunit>
