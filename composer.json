{
    "name": "graystackit/laravel-mollie-billing",
    "description": "Batteries-included Mollie billing for Laravel: VAT/OSS compliance, wallet-based metered billing, coupons, scheduled plan changes, trial flow, admin panel and a Livewire 4 customer portal.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "laravel-package",
        "mollie",
        "billing",
        "subscriptions",
        "recurring-payments",
        "metered-billing",
        "wallet",
        "vat",
        "oss",
        "coupons",
        "livewire",
        "flux"
    ],
    "authors": [
        {
            "name": "Graystack IT GmbH",
            "homepage": "https://github.com/GraystackIT"
        }
    ],
    "support": {
        "issues": "https://github.com/GraystackIT/laravel-mollie-billing/issues",
        "source": "https://github.com/GraystackIT/laravel-mollie-billing"
    },
    "require": {
        "php": "^8.3",
        "bavix/laravel-wallet": "^11.5|^12.0",
        "brick/money": "^0.11",
        "dragonmantank/cron-expression": "^3.4",
        "elegantly/laravel-invoices": "^4.8",
        "horstoeko/invoicesuite": "^0.0.44",
        "laravel/framework": "^12.0|^13.0",
        "laravel/prompts": "^0.3|^1.0",
        "livewire/flux": "^2.0",
        "livewire/livewire": "^4.0",
        "mollie/laravel-mollie": "^4.1",
        "mpociot/vat-calculator": "^3.26",
        "spatie/laravel-activitylog": "^4.12|^5.0",
        "symfony/http-foundation": "^7.0|^8.0"
    },
    "suggest": {
        "livewire/flux-pro": "Required to render the bundled customer portal, checkout and admin panel Blade views (^2.0). Install separately with your Flux Pro license.",
        "ext-zip": "Required for the ZIP export of the admin invoice list."
    },
    "require-dev": {
        "league/flysystem-aws-s3-v3": "^3.35",
        "livewire/flux-pro": "^2.0",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0|^11.0",
        "orchestra/testbench-dusk": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "smalot/pdfparser": "^2.13"
    },
    "autoload": {
        "psr-4": {
            "GraystackIT\\MollieBilling\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GraystackIT\\MollieBilling\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "test": "pest --compact",
        "test:browser": "@php vendor/bin/pest --compact --configuration=phpunit.dusk.xml",
        "test:browser:quick": "@php vendor/bin/pest --compact --configuration=phpunit.dusk.quick.xml",
        "test:coverage-claims": "@php vendor/bin/pest --compact tests/Feature/Coverage",
        "test:concurrency": "@php vendor/bin/pest --compact --configuration=phpunit.concurrency.xml",
        "test:e-invoice": "@php vendor/bin/pest --compact tests/Feature/Invoice/EInvoiceKositTest.php",
        "test:concurrency:pgsql": [
            "@putenv BILLING_CONCURRENCY_DB=pgsql",
            "@php vendor/bin/pest --compact --configuration=phpunit.concurrency.xml"
        ],
        "test:concurrency:redis": [
            "@putenv BILLING_CONCURRENCY_CACHE=redis",
            "@php vendor/bin/pest --compact --configuration=phpunit.concurrency.xml"
        ],
        "test:s3": [
            "@putenv BILLING_S3_ENDPOINT=http://127.0.0.1:9000",
            "@php vendor/bin/pest --compact tests/Feature/Config/RemoteDiskLiveS3Test.php"
        ],
        "test:sandbox": "@php vendor/bin/pest --configuration=phpunit.sandbox.xml",
        "test:sandbox:browser": "@php vendor/bin/pest --configuration=phpunit.sandbox-browser.xml --exclude-filter=SubscriptionCanaryTest",
        "test:sandbox:canary": "@php vendor/bin/pest --configuration=phpunit.sandbox-browser.xml tests/SandboxBrowser/SubscriptionCanaryTest.php",
        "browser:assets": "npm run build",
        "browser:driver": "@php vendor/bin/dusk-updater detect --auto-update",
        "browser:gallery": "@php tests/Browser/gallery.php"
    },
    "extra": {
        "laravel": {
            "providers": [
                "GraystackIT\\MollieBilling\\MollieBillingServiceProvider"
            ],
            "aliases": {
                "MollieBilling": "GraystackIT\\MollieBilling\\Facades\\MollieBilling"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "name": "flux-pro",
            "type": "composer",
            "url": "https://composer.fluxui.dev"
        }
    ]
}
